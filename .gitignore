# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build output
build/
dist/
*.spec

# Secrets and local configuration
.env
.env.*
!.env.example
settings.json
*.pem
*.key
*.p12
*.pfx

# Local logs and backups
*.log
*.bak

# Application data created when running from source - switch configurations, inventories and images
# must never be committed. (The storage folder defaults to "NetUpgrade" next to the program.)
/NetUpgrade/
/IOS Images/
/Switch Configuration Backups/
.storage-migrated-v1
*.bin
*.bin.md5
*.bin.sha256
*.bin.sha512
*.xlsx

# Application database, secret vault and migration copies (normally in %LOCALAPPDATA%\NetUpgrade)
*.db
*.db-wal
*.db-shm
*.db-journal
legacy-json-backup/
pre-migration-safety-copy-*/

# Local test dependencies
.deps/
.pip-temp/
